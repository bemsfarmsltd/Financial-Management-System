{
  "name": "fund-request-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "verify:platform": "node scripts/run-typescript.cjs scripts/verify-platform-architecture.ts",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio",
    "test:security": "node scripts/run-typescript.cjs scripts/regression-security.ts",
    "outbox:process": "node scripts/run-typescript.cjs scripts/process-outbox.ts",
    "test:database": "node scripts/run-typescript.cjs scripts/regression-database.ts && node scripts/run-typescript.cjs scripts/regression-scoped-reads.ts && node scripts/run-typescript.cjs scripts/regression-outbox.ts",
    "corrections:preflight": "node scripts/run-typescript.cjs scripts/preflight-corrections.ts",
    "test:wallet": "node scripts/run-wallet-regressions.cjs && node scripts/run-group-regressions.cjs",
    "wallet:process": "node scripts/run-typescript.cjs scripts/process-wallet-transfers.ts",
    "wallet:preflight": "node scripts/run-typescript.cjs scripts/wallet-preflight.ts",
    "wallet:reconcile": "node scripts/run-typescript.cjs scripts/reconcile-wallet.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "@types/node": "^22.13.4",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.6.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.475.0",
    "next": "^15.2.0",
    "nodemailer": "^10.1.7",
    "postcss": "^8.5.30",
    "prisma": "^6.4.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.34.1",
    "tailwind-merge": "^3.0.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "postcss": "$postcss",
    "deepmerge-ts": "8.0.2",
    "postcss-selector-parser": "7.1.6",
    "braces": "^3.0.3"
  }
}
