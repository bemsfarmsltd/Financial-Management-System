# BEMS Group Fund Request & Accountability System — Environment Template
# Copy this file to .env and fill in environment-specific values. Never commit real credentials.

# PostgreSQL Database Connections
DATABASE_URL="postgresql://user:password@localhost:5432/bems_erp?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/bems_erp?schema=public"

# Public Base URL
NEXT_PUBLIC_APP_URL="https://bemserp.work"

# AI Orchestration & Delegation Signing (n8n Bridge)
N8N_CHAT_WEBHOOK_URL="https://n8n.example.com/webhook/bems-ai-copilot"
BEMS_AI_SERVICE_TOKEN="replace_with_32_byte_hex_service_token"
BEMS_N8N_SHARED_SECRET="replace_with_32_byte_hmac_shared_secret"

# Transactional Email (Resend / SMTP)
RESEND_API_KEY="re_replace_with_resend_api_key"
EMAIL_FROM="BEMS Group Governance <noreply@bemserp.work>"
SMTP_HOST="smtp.example.com"
SMTP_PORT="465"
SMTP_USER="noreply@bemserp.work"
SMTP_PASS="replace_with_smtp_password"

# Outbound Notification Bridge (Slack & WhatsApp Cloud API)
SLACK_WEBHOOK_URL=""
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_ID=""

# Seed Safeguard (never set to true in production unless explicitly bootstrapping an empty test instance)
ALLOW_PRODUCTION_SEED="false"

# Dedicated key for signed read/stage delegations. Generate at least 32 random bytes.
BEMS_DELEGATION_SIGNING_SECRET=""
BEMS_APKSIGNER_PATH=""
BEMS_AAPT_PATH=""
BEMS_GMD_APK_CERT_SHA256=""
BEMS_STAFF_APK_CERT_SHA256=""

# Set only when your reverse proxy overwrites this header on every request.
BEMS_TRUSTED_CLIENT_IP_HEADER=

# Native release build environment only; never commit the keystore or its credentials.
BEMS_RELEASE_KEYSTORE_PATH=
BEMS_RELEASE_STORE_PASSWORD=
BEMS_RELEASE_KEY_ALIAS=
BEMS_RELEASE_KEY_PASSWORD=

# Set the Graph API version supported by your WhatsApp application.
WHATSAPP_GRAPH_API_VERSION=

# Wallet rollout is opt-in. Do not enable against existing data before reviewed cutover.
BEMS_WALLET_ENABLED=false
MONNIFY_ENVIRONMENT=sandbox
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_SOURCE_ACCOUNT=
BEMS_WALLET_FEE_RESERVE_MINOR=
# Controlled financial approver designation; role editing alone does not grant release authority.
BEMS_FINANCIAL_GMD_ID=
# Full wallet rollout gates. Enable live only after reviewed opening reconciliation and pilot authorization.
BEMS_WALLET_LIVE_ENABLED=false
BEMS_WALLET_OPENING_RECONCILED=false
BEMS_WALLET_TRANSFERS_ENABLED=false
# Set against your verified merchant tariff, in kobo. Staff principal is never charged.
BEMS_WALLET_MAX_TRANSFER_FEE_MINOR=
BEMS_WALLET_MIN_WITHDRAWAL_MINOR=10000
BEMS_WALLET_DAILY_LIMIT_MINOR=2500000000
# Confirm HMAC_SHA512 using merchant sandbox/live test evidence before live activation.
MONNIFY_WEBHOOK_SIGNATURE_MODE=HMAC_SHA512
MONNIFY_MERCHANT_CODE=
# Optional additional provider callback; review Monnify PND behavior before enabling.
BEMS_MONNIFY_VALIDATION_ENABLED=false

# ISO timestamp agreed for provider-history cutover; required for reconciliation.
BEMS_WALLET_CUTOVER_AT=
BEMS_WALLET_RECONCILE_MAX_PAGES=20
# Sandbox-only test override. Live mode always refreshes stale backing.
BEMS_WALLET_AUTO_REFRESH=true
