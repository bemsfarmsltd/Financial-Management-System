# ==============================================================================
# BEMS GROUP - PRODUCTION ENVIRONMENT VARIABLES (HOSTINGER + SUPABASE)
# ==============================================================================

# 1. Supabase PostgreSQL Connection Strings
# In your Supabase Dashboard: Go to Project Settings -> Database -> Connection Pooling
# DATABASE_URL: Transaction Pooler connection string (Port 6543)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: Direct session connection string for Prisma migrations (Port 5432)
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# 2. Application & Authentication
NODE_ENV="production"
PORT=3000
NEXT_PUBLIC_APP_URL="https://yourdomain.com"
SESSION_SECRET="generate-a-strong-32-character-random-key"

# 3. Initial Setup Key
BEMS_BOOTSTRAP_SECRET="generate-a-strong-random-bootstrap-secret"

# 4. Optional Third-Party Notification Bridges (Slack & WhatsApp)
SLACK_WEBHOOK_URL="your-slack-incoming-webhook-url"
WHATSAPP_API_TOKEN="your-whatsapp-access-token"
WHATSAPP_PHONE_NUMBER_ID="100000000000000"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="your-whatsapp-webhook-token"

# 5. BEMS AI Group Financial Manager (n8n Workflow Gateway)
# Set your production n8n webhook URL once published (e.g. https://n8n.bemsgroup.com/webhook/bems-financial-manager)
N8N_AI_WEBHOOK_URL=""
N8N_AI_SHARED_SECRET=""
