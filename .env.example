# ==============================================================================
# BEMS ERP | Fund Request & Accountability System — Environment Template
# Copy this file to .env and fill in environment-specific credentials.
# ==============================================================================

# 1. PostgreSQL Database Connections (Supabase / Neon / Local)
DATABASE_URL="postgresql://user:password@localhost:5432/bems_erp?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/bems_erp?schema=public"

# 2. Public Base URL & Authentication Secret
NEXT_PUBLIC_APP_URL="https://bemserp.work"
BEMS_BOOTSTRAP_SECRET="replace_with_32_byte_random_secret"

# 3. Transactional Email (Resend)
RESEND_API_KEY="re_replace_with_resend_api_key"
RESEND_FROM="BEMS Group Notifications <notifications@bemserp.work>"

# 4. Monnify Live Verification & Disbursement Credentials
MONNIFY_ENV="live" # live or sandbox
MONNIFY_API_KEY="replace_with_monnify_api_key"
MONNIFY_SECRET_KEY="replace_with_monnify_secret_key"
MONNIFY_CONTRACT_CODE="replace_with_contract_code"
MONNIFY_WALLET_ACCOUNT_NUMBER="replace_with_10_digit_monnify_account"

# 5. GMD AI Copilot (n8n Webhook Bridge)
N8N_AI_WEBHOOK_URL="https://n8n.example.com/webhook/bems-financial-manager"
N8N_HR_WEBHOOK_URL="https://n8n.example.com/webhook/bems-hr-operations"
BEMS_N8N_SHARED_SECRET="replace_with_32_byte_hmac_shared_secret"
